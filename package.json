{
  "name": "verimark-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev:setup": "node scripts/dev-setup.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "test": "node --env-file=.env --test --test-concurrency=1 test/*.test.js",
    "test:crypto": "node --test test/crypto.test.js",
    "attack:demo": "node --env-file=.env scripts/attack-demo.js",
    "demo": "node --env-file=.env scripts/judge-demo.js",
    "demo:existing": "node --env-file=.env scripts/demo.js",
    "typecheck": "tsc --noEmit --strict --lib ES2022,DOM docs/frontend-contract/api.types.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "zod": "^4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prisma": "6.19.3",
    "typescript": "^7.0.2"
  }
}
