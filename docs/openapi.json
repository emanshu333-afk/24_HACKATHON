{
  "openapi": "3.1.0",
  "info": {
    "title": "VeriMark API",
    "version": "1.0.0",
    "description": "Backend contract. See API.md for complete failure codes, envelope fields and trust requirements; PROOF_SPEC.md defines authenticated bytes."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "summary": "SQL-backed health",
        "responses": {
          "200": {
            "description": "Database available"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "security": [],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token, expiresIn and user"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Authenticated user",
        "responses": {
          "200": {
            "description": "id, email, role, studentId"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/students": {
      "get": {
        "summary": "Staff: list students",
        "responses": {
          "200": {
            "description": "Array of id, code, name"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/exams": {
      "get": {
        "summary": "Readers: list exams",
        "responses": {
          "200": {
            "description": "Array of id, code, title"
          }
        }
      }
    },
    "/results": {
      "get": {
        "summary": "Readers: list results, own only for students",
        "responses": {
          "200": {
            "description": "Results with exam"
          }
        }
      },
      "post": {
        "summary": "ADMIN: publish",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "studentId",
                  "examId",
                  "marks"
                ],
                "properties": {
                  "studentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "examId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "marks": {
                    "$ref": "#/components/schemas/Marks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Publication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publication"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/results/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "summary": "Readers: result, student ownership enforced",
        "responses": {
          "200": {
            "description": "Current mutable projection"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/results/{id}/history": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "summary": "Readers: published version history",
        "responses": {
          "200": {
            "description": "Versions ascending, with event"
          }
        }
      }
    },
    "/results/{id}/receipt/{version}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        },
        {
          "$ref": "#/components/parameters/Version"
        }
      ],
      "get": {
        "summary": "Readers: signed receipt and QR URL",
        "responses": {
          "200": {
            "description": "receipt and verificationUrl"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/results/{id}/marksheet/{version}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        },
        {
          "$ref": "#/components/parameters/Version"
        }
      ],
      "get": {
        "summary": "Readers: printable marksheet",
        "responses": {
          "200": {
            "description": "Authenticated marks and QR PNG",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/verify": {
      "get": {
        "security": [],
        "summary": "Public receipt capability: obtain verifiable evidence",
        "parameters": [
          {
            "name": "receipt",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 4096,
              "description": "base64url UTF-8 JSON signed receipt"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Proof"
          },
          "400": {
            "description": "Malformed or forged receipt"
          }
        }
      },
      "post": {
        "security": [],
        "summary": "Public receipt verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "receipt"
                ],
                "properties": {
                  "receipt": {
                    "$ref": "#/components/schemas/SignedEnvelope"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Proof"
          },
          "400": {
            "description": "Forged receipt"
          }
        }
      }
    },
    "/results/{id}/corrections": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "post": {
        "summary": "ADMIN: propose correction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "baseVersion",
                  "marks",
                  "reason"
                ],
                "properties": {
                  "baseVersion": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "marks": {
                    "$ref": "#/components/schemas/Marks"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable proposal body and digest"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/corrections": {
      "get": {
        "summary": "Staff: proposals and approvals",
        "responses": {
          "200": {
            "description": "Proposal array"
          }
        }
      }
    },
    "/corrections/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "summary": "Staff: exact proposal to review and sign",
        "responses": {
          "200": {
            "description": "Proposal including approvals"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/corrections/{id}/approvals": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "post": {
        "summary": "APPROVER: add real signature; second applies atomically",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "signature"
                ],
                "additionalProperties": false,
                "properties": {
                  "signature": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{86}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "proposalId, approvalCount, applied; second includes Publication"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/checkpoints/latest": {
      "get": {
        "security": [],
        "summary": "Latest signed checkpoint, not a trust root",
        "responses": {
          "200": {
            "description": "Checkpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/audits": {
      "post": {
        "summary": "ADMIN/AUDITOR: inspect actual PostgreSQL integrity",
        "responses": {
          "200": {
            "description": "status VALID/INVALID, findings, freshness, checkpointSequence"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/ledger/events": {
      "parameters": [
        {
          "name": "after",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "description": "Return events after this sequence"
        },
        {
          "name": "limit",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "description": "Max events to return"
        }
      ],
      "get": {
        "summary": "Staff: paginated ledger events",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated ledger events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events",
                    "nextAfter"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "nextAfter": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Version": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "Marks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "score",
            "max"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "pattern": "^[A-Z0-9_-]{1,32}$"
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "max": {
              "const": 100
            }
          }
        }
      },
      "SignedEnvelope": {
        "type": "object",
        "required": [
          "body",
          "signature"
        ],
        "properties": {
          "body": {
            "type": "object",
            "description": "Exact type-specific fields in PROOF_SPEC.md"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        }
      },
      "Publication": {
        "type": "object",
        "required": [
          "resultId",
          "version",
          "receipt",
          "checkpoint"
        ],
        "properties": {
          "resultId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer"
          },
          "receipt": {
            "$ref": "#/components/schemas/SignedEnvelope"
          },
          "checkpoint": {
            "$ref": "#/components/schemas/SignedEnvelope"
          }
        }
      },
      "Verification": {
        "type": "object",
        "required": [
          "status",
          "failures"
        ],
        "properties": {
          "status": {
            "enum": [
              "VALID_CURRENT",
              "VALID_HISTORICAL",
              "INVALID",
              "INCOMPLETE"
            ]
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "freshness": {
            "enum": [
              "UNWITNESSED",
              "AT_LEAST_WITNESSED_CHECKPOINT"
            ]
          },
          "checkpointSequence": {
            "type": "integer"
          },
          "currentAsOf": {
            "type": "string"
          },
          "result": {
            "type": "object"
          },
          "latestVersion": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error code; see API.md for endpoint-specific status semantics",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Proof": {
        "description": "Independent client must verify evidence against pinned institution key",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "verification",
                "evidence"
              ],
              "properties": {
                "verification": {
                  "$ref": "#/components/schemas/Verification"
                },
                "evidence": {
                  "type": "object",
                  "required": [
                    "events",
                    "checkpoint"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "checkpoint": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SignedEnvelope"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}